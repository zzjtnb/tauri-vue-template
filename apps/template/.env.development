# =================== 应用基础配置 =========================
# 开发服务端口。
# Vite dev server 会监听该端口，Tauri devUrl 也需要与它保持一致。
# 如果端口被占用，当前 Vite 配置会直接启动失败，避免连接到错误服务。
# 默认值：3001。
VITE_APP_PORT=3001

# 项目显示名称。
# 可用于页面标题、应用内展示文案或后续构建信息展示。
# 修改这里只影响前端读取到的应用名称，不等同于 Tauri 原生 productName。
# 默认值：Tauri Vue Template。
VITE_APP_TITLE=Tauri Vue Template

# =================== 接口请求配置 =========================
# 前端请求前缀。
# 开发环境一般设置为 /dev-api，此时浏览器请求 /dev-api/...，再由 Vite proxy 或 Mock 服务处理。
# 默认值：/dev-api。
VITE_APP_BASE_API=/dev-api

# 后端接口地址。
# 在本地 Web dev + Vite proxy 场景中，它是 proxy target。
# 当前开发环境默认不强制启用 Mock；如果 VITE_MOCK_DEV_SERVER=false，则这里的地址会作为 proxy target。
# 如果改成 VITE_MOCK_DEV_SERVER=true，Mock 会直接接管模板接口，此变量可以留空。
# 默认值：示例服务地址；联调时改成真实后端或本地后端。
VITE_APP_API_URL=https://api.example.com
# VITE_APP_API_URL=https://api.example.com/v2
# VITE_APP_API_URL=http://localhost:8000

# 原生 upload 插件示例上传地址。
# upload 是原生 HTTP 请求，不走浏览器相对路径；这里必须是 App 可直接访问的 http/https 绝对地址。
# 如果启用 Mock，可以使用本地 Vite mock endpoint。
# Android 模拟器或真机调试时，需要把 localhost 替换成宿主机可访问 IP。
# 默认值：示例服务上传地址；没有真实上传服务时可切换到本地 mock 示例。
VITE_UPLOAD_DEMO_URL=https://api.example.com/api/template/upload
# VITE_UPLOAD_DEMO_URL=http://localhost:3001/dev-api/api/template/upload
# VITE_UPLOAD_DEMO_URL=http://localhost:8000/api/template/upload

# =================== 本地存储配置 =========================
# Pinia 持久化 key 前缀。
# 用于区分不同项目或环境的本地缓存，避免 localStorage/sessionStorage 数据互相污染。
# 修改后旧缓存不会自动迁移，相当于使用一套新的前端持久化命名空间。
# 默认值：tauri-template。
VITE_STORE_KEY_PREFIX=tauri-template

# =================== 开发辅助配置 =========================
# Mock 服务开关。
# true 表示启用本地 Mock 数据，false 表示请求真实接口或由 Vite proxy 转发。
# 需要使用本地 Mock 的 status / echo / upload 示例时改为 true。
# 默认值：false。
VITE_MOCK_DEV_SERVER=false

# HTTP 调试日志开关。
# true 时前端会输出 [api:request]、[api:response]、[api:error] 等接口调试日志。
# 本地开发或 Android WebView 调试时可以开启；生产环境必须关闭，避免泄露请求信息。
# 默认值：false；开发环境默认开启。
VITE_APP_DEBUG=true

# UnoCSS 配置调试开关。
# true 时会把 UnoCSS resolved config 写入 backup/unocss，便于排查 preset、theme、variant 和 rules 的合并结果。
# 该文件可能较大，只在排查样式生成问题时开启。
# 默认值：false。
VITE_DEBUG_UNOCSS_CONFIG=false

# =================== 路由配置 =========================
# 路由来源。
# local：只使用前端本地静态路由定义。
# remote：后续业务可扩展为后端下发动态路由。
# hybrid：后续业务可扩展为远端优先、本地兜底。
# 默认值：local。
VITE_ROUTE_SOURCE=local
# VITE_ROUTE_SOURCE=remote
# VITE_ROUTE_SOURCE=hybrid
