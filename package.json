{
  "name": "tauri-vue-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "description": "Tauri 2 + Vue 3 starter template",
  "author": "争逐",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt-check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:init": "tauri init",
    "tauri:info": "tauri info",
    "tauri:deps": "node scripts/tauri-deps.js",
    "tauri:icon": "tauri icon public/logo.png",
    "tauri:signer": "tauri signer",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:release": "node scripts/tauri-release.js",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "android:run": "tauri android run",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "ios:run": "tauri ios run",
    "mac:dev": "tauri dev",
    "mac:build": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "windows:dev": "tauri dev",
    "windows:build": "tauri build --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "linux:dev": "tauri dev",
    "linux:build": "tauri build --target x86_64-unknown-linux-gnu --bundles deb,rpm,appimage",
    "harmony": "cargo tauri ohos",
    "harmony:init": "cargo tauri ohos init",
    "harmony:dev": "cargo tauri ohos dev",
    "harmony:build": "cargo tauri ohos build --debug --target aarch64",
    "clean": "rm -rf dist node_modules/.tmp node_modules/.cache .turbo src-tauri/target",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.js --fix --cache --cache-location node_modules/.cache/.stylelintcache",
    "lint:markdownlint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "lint:frontend": "pnpm lint:eslint && pnpm lint:stylelint",
    "lint:backend": "pnpm rust:fmt && pnpm rust:clippy",
    "lint": "pnpm lint:frontend && pnpm lint:backend && pnpm lint:markdownlint"
  },
  "dependencies": {
    "@internationalized/date": "3.12.1",
    "@tanstack/vue-table": "^9.0.0-alpha.49",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-fs": "2.4.4",
    "@tauri-apps/plugin-log": "2.7.1",
    "@tauri-apps/plugin-opener": "2.5.2",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-updater": "2.9.0",
    "@tauri-apps/plugin-upload": "2.3.2",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "@unovis/ts": "1.6.6-beta.1",
    "@unovis/vue": "^1.6.6-beta.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1-canary.2",
    "clsx": "^2.1.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^1.0.0",
    "markstream-vue": "1.0.1-beta.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.9.8",
    "tailwind-merge": "^3.6.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.6.0-alpha.7",
    "vue-input-otp": "^0.3.2",
    "vue-router": "^5.0.7",
    "vue-sonner": "^2.0.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@iconify-json/lucide": "^1.2.109",
    "@iconify/utils": "^3.1.3",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "^25.9.1",
    "@unocss/preset-wind4": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.0",
    "eslint-config-zzjtnb": "^0.0.9",
    "jszip": "^3.10.1",
    "markdownlint-cli2": "^0.22.1",
    "sass": "^1.99.0",
    "shadcn-vue": "^2.7.3",
    "stylelint": "^17.12.0",
    "stylelint-config-zzjtnb": "^0.0.11",
    "svg-text-to-path": "^2.1.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.0",
    "vite": "^8.0.14",
    "vite-plugin-mock-dev-server": "^2.3.0",
    "vue-tsc": "^3.3.2"
  }
}
