{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "node_modules/.tmp/**"]
    },
    "preview": { "cache": false },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "type-check": {
      "dependsOn": ["transit"],
      "outputs": ["node_modules/.tmp/**"]
    },
    "format": { "cache": false },
    "lint:rust": { "cache": false }
  }
}
