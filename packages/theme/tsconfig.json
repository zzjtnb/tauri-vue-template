{
  // theme 包的 TypeScript 配置只描述主题源码和打包配置的类型检查边界，避免依赖应用侧 tsconfig 规则。
  "compilerOptions": {
    // 开启增量类型检查，让 tsc 复用上一次语义分析结果；配合 Turbo 缓存时可以减少重复 type-check 成本。
    "incremental": true,
    // 把增量类型检查缓存写入包内依赖缓存目录，避免 .tsbuildinfo 出现在源码目录，也方便按包清理缓存。
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    // 以最新 ECMAScript 作为类型检查目标；主题包由现代构建工具处理，不在 TypeScript 层做语法降级。
    "target": "ESNext",
    // 主题源码可能引用浏览器样式、DOM API 或可迭代 DOM 集合，因此同时引入 ESNext、DOM 和 DOM.Iterable 类型。
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // 强制所有源码按模块处理，避免没有 import/export 的文件退回脚本模式并产生隐式全局变量。
    "moduleDetection": "force",
    // 保持 ESM 模块语义，与 package.json 的 type: module 以及 tsdown 构建输出方向一致。
    "module": "ESNext",
    // 使用 bundler 解析模式，匹配 Vite/tsdown 对 package.json exports、imports 和扩展名的现代解析规则。
    "moduleResolution": "bundler",
    // 允许主题源码直接导入 JSON 配置或令牌文件，并让这些导入参与类型检查。
    "resolveJsonModule": true,
    // theme 包源码可能在构建脚本或配置中使用 Node 类型，只暴露 Node 全局类型以避免混入测试框架全局类型。
    "types": ["node"],
    // 允许 ESM 导入语句显式写 .ts 扩展，匹配当前源码在构建工具解析下的模块边界。
    "allowImportingTsExtensions": true,
    // 开启严格类型检查，避免主题 token、样式配置和构建输入退化为隐式 any。
    "strict": true,
    // 检查 switch 分支是否意外贯穿，避免主题模式、颜色类型或平台分支遗漏 break/return。
    "noFallthroughCasesInSwitch": true,
    // 检查未使用的局部变量，避免主题包公共 API 调整后留下无效实现。
    "noUnusedLocals": true,
    // 检查未使用的函数参数，避免回调、转换函数或构建配置参数和真实契约不一致。
    "noUnusedParameters": true,
    // 生成声明文件类型信息的检查规则交给 TypeScript 参与校验；实际声明产物由 tsdown 构建阶段输出。
    "declaration": true,
    // 为构建阶段声明映射保留类型检查配置，使 dist 声明可以回溯源码；type-check 阶段因 noEmit 不直接写出文件。
    "declarationMap": true,
    // type-check 脚本只做类型检查，不直接生成 JavaScript、声明文件或 sourcemap，避免和 tsdown 的构建职责重叠。
    "noEmit": true,
    // 保留源码中的 ESM import/export 写法，不让 TypeScript 重写模块边界，保证构建器按原始 ESM 语义处理。
    "verbatimModuleSyntax": true,
    // 限制源码只使用可擦除的 TypeScript 语法，避免源码阶段执行或构建器解析时依赖额外语法转译。
    "erasableSyntaxOnly": true,
    // 跳过第三方声明文件内部检查，把类型错误聚焦在 theme 包源码、配置边界和真实调用契约上。
    "skipLibCheck": true,
    // 检查副作用导入是否能被解析，提前暴露样式入口、资源声明或内部路径引用错误。
    "noUncheckedSideEffectImports": true
  },
  // 只纳入主题源码和 tsdown 打包配置，确保包内类型检查覆盖真实入口而不扫描无关文件。
  "include": ["src/**/*.ts", "src/**/*.d.ts", "tsdown.config.ts"],
  // 排除构建产物和依赖目录，避免类型检查扫描生成文件或第三方包源码造成噪音和性能浪费。
  "exclude": ["dist", "node_modules"]
}
