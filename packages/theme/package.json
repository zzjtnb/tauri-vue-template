{
  "name": "@tauri-vue-template/theme",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Shared theme styles and UnoCSS configuration for workspace apps",
  "author": "争逐",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./unocss": {
      "types": "./src/unocss.ts",
      "import": "./src/unocss.ts",
      "default": "./src/unocss.ts"
    }
  },
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "README.md",
    "dist",
    "src/styles"
  ],
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@iconify/utils": "^3.1.3",
    "@unocss/preset-wind4": "^66.7.0",
    "markstream-vue": "1.0.1-beta.1",
    "unocss": "^66.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.1",
    "typescript": "~6.0.3"
  }
}
